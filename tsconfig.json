{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "react-native": ["__mocks__/react-native.ts"],
      "react-native-*": ["__mocks__/react-native-stub.ts"],
      "@nozbe/watermelondb": ["__mocks__/watermelondb.ts"],
      "@nozbe/watermelondb/*": ["__mocks__/watermelondb.ts"],
      "@react-native-community/*": ["__mocks__/react-native-stub.ts"],
      "zustand": ["__mocks__/zustand.ts"]
    }
  },
  "include": ["src/**/*", "__mocks__/**/*", "__tests__/**/*"],
  "exclude": ["node_modules", "dist"]
}
